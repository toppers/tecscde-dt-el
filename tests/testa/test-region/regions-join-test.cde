import("celltypes.cdl");

// 目視確認用: リージョンをまたぐ結合を含むテストデータ（第6B章6B.5 結合スタブ）
//
//   N::A  ── a1 (tLogger), s1 (tSensor)
//     └ N::A::A1 ── a2 (tLogger)
//   N::B  ── b1 (tController), b2 (tController), s2 (tSensor)
//
// 結合（呼び口側 → 受け口側）:
//   b1.cLog    → a1.eLog   (B → A)        Aを非表示にするとb1側にスタブ
//   b1.cSensor → s1.eRead  (B → A)        同上
//   b2.cLog    → a2.eLog   (B → A::A1)    A または A1 を非表示にするとb2側にスタブ
//   b2.cSensor → s2.eRead  (B → B)        同じリージョン内。Aを非表示にしても通常の線のまま
//
// 試すこと:
//   1. 「リージョン」で N::A を外す → a1, s1, a2 が消え、b1/b2 に4mmのスタブと先端の横線
//   2. N::A::A1 だけを外す → a2 だけ消え、b2.cLog のスタブのみ。b1の2本は通常の線のまま
//   3. N::B を外す → b1, b2, s2 が消え、a1/s1/a2 側にスタブ
//   4. N を外す → すべて消える（結合も消える）
//   5. 「色分け」をオン → 左端の帯と左下の凡例の色が一致
namespace N {
  region A {
    
    
    region A1 {
      
    






cell tLogger a2 {
};
};
  












cell tLogger a1 {
};

cell tSensor s1 {
};
};
  region B {
    
    
    
  


















cell tController b1 {
  cLog = a1.eLog;
  cSensor = s1.eRead;
};

cell tController b2 {
  cLog = a2.eLog;
  cSensor = s2.eRead;
};

cell tSensor s2 {
};
};
};

